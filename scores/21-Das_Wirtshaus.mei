      <body xml:id="body-0000000415670454">
         <mdiv xml:id="m4n7575">
            <score xml:id="sxnai0o2">
               <scoreDef xml:id="smv8wu51">
                  <pgHead xml:id="pnw9jkm2" func="first">
                     <rend xml:id="r7bh4771" halign="center" valign="middle">
                        <rend xml:id="rbkdq1f" type="user_1">Winterreise, D.911</rend>
                        <lb xml:id="llj4l6t1"/>
                        <rend xml:id="rwvaylr2" type="user_2">
                           <lb xml:id="lkym6wd"/>21. Das Wirtshaus</rend>
                     </rend>
                     <rend xml:id="ri800by1" halign="left" valign="bottom">
                        <rend xml:id="rn9bm9d" type="poet">Wilhelm Müller</rend>
                     </rend>
                     <rend xml:id="rimodwk2" halign="right" valign="bottom">
                        <rend xml:id="rfenmsm2" type="composer">Franz Schubert</rend>
                     </rend>
                  </pgHead>
                  <staffGrp xml:id="sutst2k1">
                     <staffDef xml:id="shqh4h7" keysig="1f" lines="5" meter.sym="common" n="1">
                        <label xml:id="l8jyftf">Singstimme</label>
                        <clef xml:id="cptq13f1" line="2" shape="G"/>
                     </staffDef>
                     <staffGrp xml:id="sum5m1d1" bar.thru="true" symbol="brace">
                        <label xml:id="ltd39o41">Pianoforte</label>
                        <staffDef xml:id="s266uoj1" keysig="1f" lines="5" meter.sym="common" n="2">
                           <clef xml:id="cecrq19" line="2" shape="G"/>
                        </staffDef>
                        <staffDef xml:id="spmkrg2" keysig="1f" lines="5" meter.sym="common" n="3">
                           <clef xml:id="c3uw7jh1" line="4" shape="F"/>
                        </staffDef>
                     </staffGrp>
                  </staffGrp>
               </scoreDef>
               <section xml:id="s1">
                  <pb xml:id="pb-0000003879756080" n="1"/>
                  <measure xml:id="m1njy8sa" facs="#zone_01K4AD56MJW4S0GVKYFBZY1CKV" n="1">
                     <annot xml:id="annot-0000000895699991">vertical lines through the alla breve symbols, rendering them alla semibreve? (although a 4 is added between the upper two staves), DFD copy</annot>
                     <annot xml:id="annot-0000000719034108">"tief?" to the right of the title, DFD copy</annot>
                     <annot xml:id="annot-0000000014279896">"D-Dur" left, DFD copy</annot>
                     <annot xml:id="annot-0000001087389757" plist="#d3vfplv" type="score">circled, DFD copy</annot>
                     <staff xml:id="m1s1" n="1">
                        <layer xml:id="m1s1l1" n="1">
                           <mRest xml:id="m103fc3k"/>
                        </layer>
                     </staff>
                     <staff xml:id="m1s2" n="2">
                        <layer xml:id="m1s2l1" n="1">
                           <chord xml:id="c11jrf83" dur="4" stem.dir="up">
                              <del xml:id="dao365n1" source="#dwdfd93012b6f-2724-4fb5-95f4-82bf3c316a30">
